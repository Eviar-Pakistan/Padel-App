// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//Prisma schema mein moduleFormat = "cjs" ka matlab yeh hai ke jab Prisma aapke liye JavaScript client code banaye, toh woh CommonJS (CJS) style (require aur module.exports) use kare, na ke naya import/export (ESM) style.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat ="cjs"
}

datasource db {
  provider = "sqlite"
}


model User {
  id            Int            @id @default(autoincrement())
  fullName      String
  mobileNumber  String         @unique
  cnicNumber    String         @unique
  password      String
  profileImage  String?
  handedness    String? // or an enum: LEFT / RIGHT / AMBIDEXTROUS
  skillLevel    String         @default("BEGINNER") // BEGINNER / INTERMEDIATE / ADVANCED
  location      String?
  province      String?
  isProfilePublic Boolean      @default(false)
  rank          Int            @default(0)
  points        Int            @default(0)
  wins          Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  coachReviews  CoachReview[]
  coachBookings CoachBooking[]
  coachConversations CoachConversation[]
  coachConversationMessages CoachConversationMessage[]
  orders        Order[]
  courtBookings CourtBooking[]
  courtBookingParticipants CourtBookingParticipant[]
  courtBookingJoinRequests CourtBookingJoinRequest[]
  notificationsReceived Notification[] @relation("NotificationReceiver")
  newsPosts     NewsPost[]
  newsLikes     NewsLike[]
  newsSaves     NewsSave[]
  newsComments  NewsComment[]
  newsCommentLikes NewsCommentLike[]
  chatMemberships ChatGroupMember[]
  chatJoinRequests ChatJoinRequest[]
  chatMessages  ChatMessage[]
  challengesSent PlayerChallenge[] @relation("ChallengeChallenger")
  challengesReceived PlayerChallenge[] @relation("ChallengeOpponent")
  playerConversationsLow UserConversation[] @relation("PlayerConvLow")
  playerConversationsHigh UserConversation[] @relation("PlayerConvHigh")
  playerConversationMessages UserConversationMessage[]
}

model PaddleOwner {
  id               Int       @id @default(autoincrement())
  organizationName String
  username         String    @unique
  location         String
  number           String
  password         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  products         Product[]
  productCategories ProductCategory[]
  productBrands    ProductBrand[]
  orders           Order[]
  courts           Court[]
  newsPosts        NewsPost[]
  coaches          Coach[]
  chatGroups       ChatGroup[]
  chatMessages     ChatMessage[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model ProductCategory {
  id            String    @id @default(uuid())
  paddleOwnerId Int
  name          String
  slug          String
  description   String?
  paddleOwner   PaddleOwner @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([paddleOwnerId, slug])
  @@index([paddleOwnerId])
}

model ProductBrand {
  id            String    @id @default(uuid())
  paddleOwnerId Int
  name          String
  slug          String
  paddleOwner   PaddleOwner @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([paddleOwnerId, slug])
  @@index([paddleOwnerId])
}

model Product {
  id               String         @id @default(uuid())
  paddleOwnerId    Int
  categoryId       String
  brandId          String?
  name             String
  slug             String
  description      String?
  shortDescription String?
  sku              String?
  price            Decimal
  currency         String         @default("PKR")
  specifications   Json?
  status           ProductStatus  @default(DRAFT)
  stock            Int            @default(0)
  weight           Decimal?
  length           Decimal?
  width            Decimal?
  height           Decimal?
  paddleOwner      PaddleOwner    @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  category         ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand            ProductBrand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  orderItems       OrderItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([paddleOwnerId, slug])
  @@index([paddleOwnerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Order {
  id              String      @id @default(uuid())
  userId          Int
  paddleOwnerId   Int
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal
  shippingAddress String?
  notes           String?
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paddleOwner     PaddleOwner @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal // price snapshot at order time
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CoachStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WeekDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Coach {
  id                 String       @id @default(uuid())
  firstName          String
  lastName           String
  profileImage       String?
  email              String       @unique
  phoneNumber        String
  gender             Gender?
  dateOfBirth        DateTime?
  nationality        String?
  languages          Json? // string[] stored as JSON (SQLite)
  bio                String?
  yearsOfExperience  Int?
  certificationLevel String?
  specialties        Json? // string[] stored as JSON (SQLite)
  sessionRate        Decimal?
  availableFromDay   WeekDay?
  availableToDay     WeekDay?
  availableFromTime  String? // "09:00"
  availableToTime    String? // "18:00"
  isVerified         Boolean      @default(false)
  rating             Decimal?     @default(0)
  totalReviews       Int          @default(0)
  status             CoachStatus  @default(ACTIVE)
  password           String? // hashed; required for coach portal login
  paddleOwnerId      Int?
  paddleOwner        PaddleOwner? @relation(fields: [paddleOwnerId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  reviews            CoachReview[]
  bookings           CoachBooking[]
  conversations      CoachConversation[]
  conversationMessages CoachConversationMessage[]
}

model CoachReview {
  id        String   @id @default(uuid())
  rating    Int // 1-5
  comment   String?
  coachId   String
  userId    Int
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coachId, userId])
}

model CoachBooking {
  id          String        @id @default(uuid())
  coachId     String
  userId      Int
  bookingDate DateTime
  startTime   String // "16:00"
  endTime     String // "17:00"
  status      BookingStatus @default(PENDING)
  totalPrice  Decimal
  notes       String?
  coach       Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation CoachConversation?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([coachId, bookingDate, startTime])
  @@index([userId])
  @@index([coachId])
}

model CoachConversation {
  id             String   @id @default(uuid())
  coachId        String
  userId         Int
  bookingId      String?  @unique
  coachLastReadAt DateTime?
  userLastReadAt  DateTime?
  coach          Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking        CoachBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages       CoachConversationMessage[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([coachId, userId])
  @@index([userId])
  @@index([coachId])
}

model CoachConversationMessage {
  id               String          @id @default(uuid())
  conversationId   String
  senderCoachId    String?
  senderUserId     Int?
  type             ChatMessageType @default(TEXT)
  text             String?
  mediaUrl         String?
  fileName         String?
  mimeType         String?
  durationSec      Int?
  createdAt        DateTime        @default(now())
  conversation     CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderCoach      Coach?          @relation(fields: [senderCoachId], references: [id], onDelete: SetNull)
  senderUser       User?           @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // store hashed password only
  isAdmin   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CourtEnvironmentType {
  INDOOR
  OUTDOOR
  SEMI_INDOOR
  SEMI_OUTDOOR
}

model Court {
  id              String               @id @default(uuid())
  name            String
  images          Json                 @default("[]") // string[] of uploaded image URLs
  pricePerHour    Decimal // PKR
  environmentType CourtEnvironmentType @default(OUTDOOR)
  address         String?
  latitude        Float?
  longitude       Float?
  isActive        Boolean              @default(true)
  paddleOwnerId   Int
  paddleOwner     PaddleOwner          @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  timeSlots       CourtTimeSlot[]
  bookings        CourtBooking[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

/// Recurring daily availability templates, e.g. 06:00-07:00 every day
model CourtTimeSlot {
  id        String         @id @default(uuid())
  courtId   String
  startTime String // "06:00"
  endTime   String // "07:00"
  court     Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookings  CourtBooking[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([courtId, startTime, endTime])
}

model CourtBooking {
  id             String                     @id @default(uuid())
  courtId        String
  timeSlotId     String
  userId         Int // booking owner
  bookingDate    DateTime // specific calendar day
  status         BookingStatus              @default(PENDING)
  totalPrice     Decimal // snapshot of pricePerHour
  notes          String?
  isPublic       Boolean                    @default(false)
  /// Remaining open player spots (out of 4). Owner occupies at least 1.
  availableSlots Int                        @default(0)
  court          Court                      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  timeSlot       CourtTimeSlot              @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants   CourtBookingParticipant[]
  joinRequests   CourtBookingJoinRequest[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([timeSlotId, bookingDate])
}

/// Extra players who joined a public court booking (not the booking owner)
model CourtBookingParticipant {
  id        String       @id @default(uuid())
  bookingId String
  userId    Int
  booking   CourtBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([bookingId, userId])
  @@index([userId])
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// User B requests to join User A's public booking; owner must accept
model CourtBookingJoinRequest {
  id          String            @id @default(uuid())
  bookingId   String
  requesterId Int
  status      JoinRequestStatus @default(PENDING)
  booking     CourtBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requester   User              @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([bookingId, requesterId])
  @@index([requesterId])
  @@index([status])
}

enum NewsCategory {
  ANNOUNCEMENT
  TOURNAMENT
  EVENT
  COACHING
  MATCH
  TRAINING
  PRODUCT
  OFFER
  MEMBERSHIP
  COURT
  ACHIEVEMENT
  COMMUNITY
  RECRUITMENT
  NEWS
  MEDIA
}

enum NewsAuthorType {
  USER
  PADDLE_OWNER
}

model NewsPost {
  id            String         @id @default(uuid())
  authorType    NewsAuthorType
  userId        Int?
  paddleOwnerId Int?
  authorName    String
  location      String
  description   String
  category      NewsCategory
  images        Json           @default("[]")
  likeCount     Int            @default(0)
  commentCount  Int            @default(0)
  saveCount     Int            @default(0)
  shareCount    Int            @default(0)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paddleOwner   PaddleOwner?   @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  likes         NewsLike[]
  comments      NewsComment[]
  saves         NewsSave[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt, id])
  @@index([category, createdAt])
  @@index([location, createdAt])
  @@index([userId])
  @@index([paddleOwnerId])
}

model NewsLike {
  id        String   @id @default(uuid())
  postId    String
  userId    Int
  post      NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model NewsSave {
  id        String   @id @default(uuid())
  postId    String
  userId    Int
  post      NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model NewsComment {
  id        String            @id @default(uuid())
  postId    String
  userId    Int
  parentId  String?
  body      String
  likeCount Int               @default(0)
  post      NewsPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    NewsComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   NewsComment[]     @relation("CommentReplies")
  likes     NewsCommentLike[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
}

model NewsCommentLike {
  id        String      @id @default(uuid())
  commentId String
  userId    Int
  comment   NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

/// General-purpose notifications (type is a free-form string, not an enum).
/// receiverId always refers to a User.
/// senderId is a plain int (User id, PaddleOwner id, etc. depending on type).
/// Current type examples: "Booking Details", "Shopping Details", "Court Slot Join", "Order Status", "Player Challenge", "Challenge Accepted"
model Notification {
  id         String   @id @default(uuid())
  receiverId Int
  senderId   Int
  type       String
  message    String
  isRead     Boolean  @default(false)
  /// Optional action payload, e.g. { "action": "ACCEPT_JOIN", "joinRequestId": "..." }
  meta       Json?
  receiver   User     @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([receiverId])
  @@index([senderId])
  @@index([type])
  @@index([receiverId, createdAt])
  @@index([receiverId, isRead])
}

enum PlayerChallengeStatus {
  PENDING
  ACCEPTED
}

model PlayerChallenge {
  id             String                 @id @default(uuid())
  challengerId   Int
  opponentId     Int
  status         PlayerChallengeStatus  @default(PENDING)
  conversationId String?                @unique
  challenger     User                   @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent       User                   @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  conversation   UserConversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([challengerId])
  @@index([opponentId])
  @@index([status])
}

model UserConversation {
  id          String                     @id @default(uuid())
  userLowId   Int
  userHighId  Int
  userLow     User                       @relation("PlayerConvLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    User                       @relation("PlayerConvHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  challenge   PlayerChallenge?
  messages    UserConversationMessage[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
}

model UserConversationMessage {
  id             String           @id @default(uuid())
  conversationId String
  senderUserId   Int
  type           ChatMessageType  @default(TEXT)
  text           String?
  mediaUrl       String?
  fileName       String?
  mimeType       String?
  durationSec    Int?
  createdAt      DateTime         @default(now())
  conversation   UserConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User             @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum ChatJoinStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ChatGroup {
  id            String             @id @default(uuid())
  name          String
  description   String?
  image         String?
  paddleOwnerId Int
  paddleOwner   PaddleOwner        @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  members       ChatGroupMember[]
  messages      ChatMessage[]
  joinRequests  ChatJoinRequest[]
}

model ChatGroupMember {
  id       String    @id @default(uuid())
  groupId  String
  userId   Int
  group    ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model ChatJoinRequest {
  id        String         @id @default(uuid())
  groupId   String
  userId    Int
  status    ChatJoinStatus @default(PENDING)
  group     ChatGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model ChatMessage {
  id            String          @id @default(uuid())
  groupId       String
  senderUserId  Int?
  senderOwnerId Int?
  type          ChatMessageType @default(TEXT)
  text          String?
  mediaUrl      String?
  fileName      String?
  mimeType      String?
  durationSec   Int?
  createdAt     DateTime        @default(now())
  group         ChatGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderUser    User?           @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderOwner   PaddleOwner?    @relation(fields: [senderOwnerId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}
