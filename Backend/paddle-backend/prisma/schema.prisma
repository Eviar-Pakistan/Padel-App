// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//Prisma schema mein moduleFormat = "cjs" ka matlab yeh hai ke jab Prisma aapke liye JavaScript client code banaye, toh woh CommonJS (CJS) style (require aur module.exports) use kare, na ke naya import/export (ESM) style.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat ="cjs"
}

datasource db {
  provider = "sqlite"
}


model User {
  id            Int            @id @default(autoincrement())
  fullName      String
  mobileNumber  String         @unique
  cnicNumber    String         @unique
  password      String
  profileImage  String?
  handedness    String? // or an enum: LEFT / RIGHT / AMBIDEXTROUS
  skillLevel    String         @default("BEGINNER") // BEGINNER / INTERMEDIATE / ADVANCED
  location      String?
  rank          Int            @default(0)
  points        Int            @default(0)
  wins          Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  coachReviews  CoachReview[]
  orders        Order[]
  courtBookings CourtBooking[]
  newsPosts     NewsPost[]
  newsLikes     NewsLike[]
  newsSaves     NewsSave[]
  newsComments  NewsComment[]
  newsCommentLikes NewsCommentLike[]
}

model PaddleOwner {
  id               Int       @id @default(autoincrement())
  organizationName String
  username         String    @unique
  location         String
  number           String
  password         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  products         Product[]
  productCategories ProductCategory[]
  productBrands    ProductBrand[]
  orders           Order[]
  courts           Court[]
  newsPosts        NewsPost[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model ProductCategory {
  id            String    @id @default(uuid())
  paddleOwnerId Int
  name          String
  slug          String
  description   String?
  paddleOwner   PaddleOwner @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([paddleOwnerId, slug])
  @@index([paddleOwnerId])
}

model ProductBrand {
  id            String    @id @default(uuid())
  paddleOwnerId Int
  name          String
  slug          String
  paddleOwner   PaddleOwner @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([paddleOwnerId, slug])
  @@index([paddleOwnerId])
}

model Product {
  id               String         @id @default(uuid())
  paddleOwnerId    Int
  categoryId       String
  brandId          String?
  name             String
  slug             String
  description      String?
  shortDescription String?
  sku              String?
  price            Decimal
  currency         String         @default("PKR")
  specifications   Json?
  status           ProductStatus  @default(DRAFT)
  stock            Int            @default(0)
  weight           Decimal?
  length           Decimal?
  width            Decimal?
  height           Decimal?
  paddleOwner      PaddleOwner    @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  category         ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand            ProductBrand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  orderItems       OrderItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([paddleOwnerId, slug])
  @@index([paddleOwnerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Order {
  id              String      @id @default(uuid())
  userId          Int
  paddleOwnerId   Int
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal
  shippingAddress String?
  notes           String?
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paddleOwner     PaddleOwner @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal // price snapshot at order time
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CoachStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Coach {
  id                 String       @id @default(uuid())
  firstName          String
  lastName           String
  profileImage       String?
  email              String       @unique
  phoneNumber        String
  gender             Gender?
  dateOfBirth        DateTime?
  nationality        String?
  languages          Json? // string[] stored as JSON (SQLite)
  bio                String?
  yearsOfExperience  Int?
  certificationLevel String?
  specialties        Json? // string[] stored as JSON (SQLite)
  sessionRate        Decimal?
  isVerified         Boolean      @default(false)
  rating             Decimal?     @default(0)
  totalReviews       Int          @default(0)
  status             CoachStatus  @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  reviews            CoachReview[]
}

model CoachReview {
  id        String   @id @default(uuid())
  rating    Int // 1-5
  comment   String?
  coachId   String
  userId    Int
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coachId, userId])
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // store hashed password only
  isAdmin   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Court {
  id            String          @id @default(uuid())
  name          String
  images        Json            @default("[]") // string[] of uploaded image URLs
  pricePerHour  Decimal // PKR
  isActive      Boolean         @default(true)
  paddleOwnerId Int
  paddleOwner   PaddleOwner     @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  timeSlots     CourtTimeSlot[]
  bookings      CourtBooking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// Recurring daily availability templates, e.g. 06:00-07:00 every day
model CourtTimeSlot {
  id        String         @id @default(uuid())
  courtId   String
  startTime String // "06:00"
  endTime   String // "07:00"
  court     Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookings  CourtBooking[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([courtId, startTime, endTime])
}

model CourtBooking {
  id          String        @id @default(uuid())
  courtId     String
  timeSlotId  String
  userId      Int
  bookingDate DateTime // specific calendar day
  status      BookingStatus @default(PENDING)
  totalPrice  Decimal // snapshot of pricePerHour
  notes       String?
  court       Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  timeSlot    CourtTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([timeSlotId, bookingDate])
}

enum NewsCategory {
  ANNOUNCEMENT
  TOURNAMENT
  EVENT
  COACHING
  MATCH
  TRAINING
  PRODUCT
  OFFER
  MEMBERSHIP
  COURT
  ACHIEVEMENT
  COMMUNITY
  RECRUITMENT
  NEWS
  MEDIA
}

enum NewsAuthorType {
  USER
  PADDLE_OWNER
}

model NewsPost {
  id            String         @id @default(uuid())
  authorType    NewsAuthorType
  userId        Int?
  paddleOwnerId Int?
  authorName    String
  location      String
  description   String
  category      NewsCategory
  images        Json           @default("[]")
  likeCount     Int            @default(0)
  commentCount  Int            @default(0)
  saveCount     Int            @default(0)
  shareCount    Int            @default(0)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paddleOwner   PaddleOwner?   @relation(fields: [paddleOwnerId], references: [id], onDelete: Cascade)
  likes         NewsLike[]
  comments      NewsComment[]
  saves         NewsSave[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt, id])
  @@index([category, createdAt])
  @@index([location, createdAt])
  @@index([userId])
  @@index([paddleOwnerId])
}

model NewsLike {
  id        String   @id @default(uuid())
  postId    String
  userId    Int
  post      NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model NewsSave {
  id        String   @id @default(uuid())
  postId    String
  userId    Int
  post      NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model NewsComment {
  id        String            @id @default(uuid())
  postId    String
  userId    Int
  parentId  String?
  body      String
  likeCount Int               @default(0)
  post      NewsPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    NewsComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   NewsComment[]     @relation("CommentReplies")
  likes     NewsCommentLike[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
}

model NewsCommentLike {
  id        String      @id @default(uuid())
  commentId String
  userId    Int
  comment   NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}
